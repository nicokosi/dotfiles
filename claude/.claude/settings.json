  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/nkosinski@france.groupe.intra/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh'",
            "timeout": 60
          }
        ],
        "matcher": "Read"
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/nkosinski@france.groupe.intra/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/nkosinski@france.groupe.intra/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh'",
            "timeout": 60
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"/home/nkosinski@france.groupe.intra/.claude/harnais/subagent-statusline.mjs\""
