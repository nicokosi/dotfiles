{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/nkosinski@france.groupe.intra/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "humanizer@humanizer": true,
    "build-brief@build-brief-local": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "build-brief-local": {
      "source": {
        "source": "directory",
        "path": "/home/nkosinski@france.groupe.intra/.claude/marketplaces/build-brief"
      }
    }
  },
  "language": "Français",
  "theme": "dark",
  "autoContinueAtUsageLimit": false
}
